<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#F9F9F9"
        android:elevation="4dp"
        android:paddingHorizontal="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:text="초기 설정"
            android:textColor="#0A192F"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStepProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:text="1 / 5"
            android:textColor="#0A192F"
            android:textSize="14sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp"
            android:gravity="center_horizontal">

            <!-- STEP 1: 이름 입력 -->
            <LinearLayout
                android:id="@+id/stepName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="연구 참여자 이름(닉네임) 입력"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/etNameInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:hint="이름 또는 닉네임"
                    android:textStyle="bold"
                    android:textColorHint="#800A192F"
                    android:gravity="center"
                    android:layout_marginBottom="12dp"/>

                <Button
                    android:id="@+id/btnSaveName"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginHorizontal="24dp"
                    android:text="다음"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_blue"
                    app:backgroundTint="@null" />
            </LinearLayout>

            <!-- STEP 2: 오버레이 권한 -->
            <LinearLayout
                android:id="@+id/stepOverlay"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="오버레이 권한을 허용해주세요."
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textAlignment="center"
                    android:layout_marginBottom="12dp" />
                <Button
                    android:id="@+id/btnOverlay"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginHorizontal="24dp"
                    android:text="오버레이 권한 설정"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_blue"
                    app:backgroundTint="@null" />
            </LinearLayout>

            <!-- STEP 3: 접근성 서비스 -->
            <LinearLayout
                android:id="@+id/stepAccessibility"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="숏폼 사용 감지를 위해\n접근성 서비스 활성화가 필요합니다."
                    android:textAlignment="center"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="8dp" />
                <TextView
                    android:id="@+id/tvAccessibilityStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="상태: 확인 중..."
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />
                <Button
                    android:id="@+id/btnAccessibility"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginHorizontal="24dp"
                    android:text="접근성 서비스 설정"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_blue"
                    app:backgroundTint="@null" />
            </LinearLayout>

            <!-- STEP 4: PIP 설정 -->
            <LinearLayout
                android:id="@+id/stepPip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PIP(화면 속 화면) 권한을 꺼주세요."
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textAlignment="center"
                    android:layout_marginBottom="12dp" />
                <Button
                    android:id="@+id/btnPipYoutube"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginHorizontal="24dp"
                    android:text="유튜브 PIP 설정"
                    android:layout_marginBottom="8dp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_blue"
                    app:backgroundTint="@null" />
                <Button
                    android:id="@+id/btnPipInstagram"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginHorizontal="24dp"
                    android:text="인스타그램 PIP 설정"
                    android:layout_marginBottom="16dp"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_blue"
                    app:backgroundTint="@null" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="두 앱 모두 PIP 권한을 껐다면 완료를 눌러주세요."
                    android:textSize="13sp"
                    android:textColor="#800A192F"
                    android:textAlignment="center"
                    android:layout_marginBottom="12dp" />
                <Button
                    android:id="@+id/btnPipDone"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginHorizontal="24dp"
                    android:text="완료"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_blue"
                    app:backgroundTint="@null" />
            </LinearLayout>

            <!-- STEP 5: 개입 타입 설정 -->
            <LinearLayout
                android:id="@+id/stepType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="개입 타입 설정"
                    android:textStyle="bold"
                    android:textAlignment="center"
                    android:textSize="16sp"
                    android:layout_marginBottom="12dp" />
                <EditText
                    android:id="@+id/etTypeInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="0, 1, 2 입력"
                    android:textStyle="bold"
                    android:textColor="#0A192F"
                    android:textColorHint="#800A192F"
                    android:inputType="number"
                    android:gravity="center"
                    android:layout_marginBottom="12dp" />
                <Button
                    android:id="@+id/btnSaveType"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginHorizontal="24dp"
                    android:text="저장하고 시작하기"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_blue"
                    app:backgroundTint="@null" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
