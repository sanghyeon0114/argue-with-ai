<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="#F9F9F9"
        android:elevation="4dp"
        android:paddingHorizontal="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:layout_marginStart="-8dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="뒤로가기"
            android:padding="12dp"
            android:src="@drawable/ic_back" />

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Settings"
            android:textColor="#0A192F"
            android:textSize="20sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:paddingHorizontal="16dp">

                <TextView
                    android:id="@+id/tvDebugOverlayLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"
                    android:text="디버그 오버레이 표시"
                    android:textColor="#0A192F"
                    android:textSize="16sp" />

                <Switch
                    android:id="@+id/switchDebugOverlay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_alignParentEnd="true" />
            </RelativeLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DDDDDD" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_alignParentStart="true"
                        android:text="파일럿 테스트 모드"
                        android:textColor="#0A192F"
                        android:textStyle="bold"
                        android:textSize="16sp" />

                    <Switch
                        android:id="@+id/switchPilotMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true" />
                </RelativeLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="켜두면 개입이 끝날 때마다 개입 시간(켜진 시점 ~ 꺼진 시점)과 타이핑 수를 기록합니다."
                    android:textColor="#800A192F"
                    android:textSize="13sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="현재 대상자"
                    android:textColor="#0A192F"
                    android:textStyle="bold"
                    android:textSize="14sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="저장해 두면 이후 기록에 자동으로 붙습니다. 기록을 누르면 개별로 수정·삭제할 수 있습니다."
                    android:textColor="#800A192F"
                    android:textSize="12sp"
                    android:layout_marginBottom="4dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">

                    <EditText
                        android:id="@+id/etPilotParticipant"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="예: P01"
                        android:inputType="text"
                        android:textColor="#0A192F"
                        android:textColorHint="#800A192F" />

                    <Button
                        android:id="@+id/btnSavePilotParticipant"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        android:layout_marginStart="8dp"
                        android:paddingHorizontal="16dp"
                        android:text="저장"
                        android:textStyle="bold"
                        android:background="@drawable/bg_button_blue"
                        app:backgroundTint="@null" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvPilotSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#F4F6F8"
                    android:padding="12dp"
                    android:text="기록 없음"
                    android:textColor="#0A192F"
                    android:textIsSelectable="true"
                    android:textSize="12sp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/llPilotRecords"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btnCopyPilotRecords"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="기록 복사 (TSV)"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_blue"
                    app:backgroundTint="@null"
                    android:layout_marginBottom="8dp" />
                <Button
                    android:id="@+id/btnDeleteSelectedPilotRecords"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="선택한 기록 삭제"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_blue"
                    app:backgroundTint="@null" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DDDDDD" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="NASA-TLX 설문"
                    android:textColor="#0A192F"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="개입 조건별 파일럿을 마친 뒤 설문을 띄워 6개 항목(0~10)을 기록합니다."
                    android:textColor="#800A192F"
                    android:textSize="13sp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btnStartTlx"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="NASA-TLX 설문 시작"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_blue"
                    app:backgroundTint="@null"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:id="@+id/tvTlxSummary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#F4F6F8"
                    android:padding="12dp"
                    android:text="응답 없음"
                    android:textColor="#0A192F"
                    android:textIsSelectable="true"
                    android:textSize="12sp"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/llTlxRecords"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btnCopyTlxRecords"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="응답 복사 (TSV)"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_blue"
                    app:backgroundTint="@null"
                    android:layout_marginBottom="8dp" />
                <Button
                    android:id="@+id/btnDeleteSelectedTlxRecords"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="선택한 응답 삭제"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_blue"
                    app:backgroundTint="@null" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DDDDDD" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="개입 타입 변경"
                    android:textColor="#0A192F"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="4dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="참여자에게 노출되는 개입 화면 타입을 바꿉니다 (0, 1, 2)."
                    android:textColor="#800A192F"
                    android:textSize="13sp"
                    android:layout_marginBottom="12dp" />
                <EditText
                    android:id="@+id/etTypeInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="0, 1, 2 입력"
                    android:textStyle="bold"
                    android:textColor="#0A192F"
                    android:textColorHint="#800A192F"
                    android:inputType="number"
                    android:gravity="center"
                    android:layout_marginBottom="12dp" />
                <Button
                    android:id="@+id/btnSaveType"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="타입 저장"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_blue"
                    app:backgroundTint="@null" />
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#DDDDDD" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="실험 종료 후 PIP 설정 원래대로 되돌리기"
                    android:textColor="#0A192F"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:layout_marginBottom="4dp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="아래 버튼으로 각 앱의 PIP 설정 화면을 열어 권한을 다시 켜주세요."
                    android:textColor="#800A192F"
                    android:textSize="13sp"
                    android:layout_marginBottom="12dp" />

                <Button
                    android:id="@+id/btnRestorePipYoutube"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="유튜브 PIP 설정 열기"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_blue"
                    app:backgroundTint="@null"
                    android:layout_marginBottom="8dp" />

                <Button
                    android:id="@+id/btnRestorePipInstagram"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:text="인스타그램 PIP 설정 열기"
                    android:textStyle="bold"
                    android:background="@drawable/bg_button_blue"
                    app:backgroundTint="@null" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
